{
  "action_manifest_version": 0,
  "category": "steamvr_input",
  "controller_type": "vive_cosmos_controller",
  "name": "vrperf watch calibration",
  "description": "Opposite grip or trigger moves the watch",
  "bindings": {
    "/actions/calibration": {
      "sources": [
        {
          "path": "/user/hand/left/input/grip",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/calibration/in/left_grip"
            }
          }
        },
        {
          "path": "/user/hand/left/input/trigger",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/calibration/in/left_trigger"
            }
          }
        },
        {
          "path": "/user/hand/right/input/grip",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/calibration/in/right_grip"
            }
          }
        },
        {
          "path": "/user/hand/right/input/trigger",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/calibration/in/right_trigger"
            }
          }
        }
      ],
      "poses": [],
      "haptics": [],
      "skeleton": [],
      "chords": []
    }
  }
}
